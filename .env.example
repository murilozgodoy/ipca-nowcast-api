# Database connection (use SQLite fallback locally if Postgres unavailable)
DATABASE_URL=postgresql+psycopg://macro:macro@localhost:5433/ipca_nowcast
# DATABASE_URL=sqlite:///./data/dev.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# Ingestion
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
RAW_DATA_DIR=./data/raw

# Logging
LOG_LEVEL=INFO
